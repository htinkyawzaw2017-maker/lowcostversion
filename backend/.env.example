# All providers start in mock mode: the UI is fully clickable with zero AI cost.
DUB_PROVIDER_TRANSCRIPTION=mock      # faster_whisper
DUB_PROVIDER_TRANSLATION=mock        # gemini
DUB_PROVIDER_TTS_MY=mock             # mms_tts | gemini_tts
DUB_PROVIDER_TTS_EN=mock             # piper | kokoro | gemini_tts
DUB_PROVIDER_TTS_FALLBACK=gemini_tts
DUB_PROVIDER_LIPSYNC=mock            # gpu_worker
DUB_PROVIDER_RENDER=mock             # ffmpeg
DUB_PROVIDER_STORAGE=local           # s3

DUB_S3_BUCKET=dub-studio-media
DUB_S3_REGION=ap-southeast-1
DUB_SECRETS_MANAGER_GEMINI_ID=dub-studio/gemini
# DUB_GEMINI_API_KEY=   # local dev only -- production uses AWS Secrets Manager

DUB_LIPSYNC_WORKER_URL=http://localhost:9100
DUB_REQUIRE_AUTH=false
DUB_ACCESS_TOKEN=change-me
